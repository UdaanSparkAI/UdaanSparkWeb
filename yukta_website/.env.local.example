# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://yukta.udaansparkai.com

# Razorpay credentials are NOT needed here any more.
#
# Subscriptions are created by the YUKTA app backend
# (POST https://api.udaansparkai.com/subscriptions/razorpay/create-subscription),
# which also receives the Razorpay webhook and grants Premium. The key id is
# returned to the browser in that endpoint's response, and the key secret and
# webhook secret live only in the backend's own environment — this website
# never holds either.
