# --- Razorpay (TEST mode) ---------------------------------------------------
# Server-side only. RAZORPAY_KEY_SECRET must never be exposed to the browser,
# so neither of these carries a NEXT_PUBLIC_ prefix — the key id is handed to
# the client by /api/payments/create-order instead.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_key_secret_here

# --- YUKTA app backend ------------------------------------------------------
# Full URL of the endpoint that grants Premium. After a payment signature is
# verified, the buyer's email is POSTed here. Must be idempotent on paymentId —
# the order.paid webhook records the same purchase independently.
ENTITLEMENT_API_URL=https://api.udaansparkai.com/subscriptions/activate
ENTITLEMENT_API_SECRET=your_shared_secret_here

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://yukta.udaansparkai.com
